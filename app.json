{
  "expo": {
    "name": "RootCause",
    "slug": "rootcause",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rootcause",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "bundleIdentifier": "com.27363.rootcause",
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "processing"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.expo.modules.backgroundtask.processing"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F6B4F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tstst.rootcause"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {}
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F6B4F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RootCause uses your location to place the hazard you are reporting and to show hazards near you. Your home location never leaves your phone except as a watch area you choose to save."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "RootCause uses the camera to photograph a hazard you are reporting. Faces and licence plates should be kept out of frame; the photo you see is exactly what is uploaded."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RootCause uses your photo library only when you choose a photo of a hazard to report. Location data is removed from the photo before upload."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F6B4F",
          "defaultChannel": "rootcause-status"
        }
      ],
      "expo-asset",
      "expo-background-task",
      "expo-localization",
      "expo-apple-authentication",
      "@maplibre/maplibre-react-native",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
