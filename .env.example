# ---- server only (never prefixed EXPO_PUBLIC_; set in production with `eas env:set ... --visibility sensitive`) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Vision assist: VISION_ENABLED is the kill switch; the runtime limit is tenant.vision_daily_max (seeded from VISION_DAILY_MAX).
ANTHROPIC_API_KEY=
VISION_MODEL=claude-haiku-4-5
VISION_ENABLED=true
VISION_DAILY_MAX=500
# SMS: SMS_ENABLED is the kill switch (preview default false); tenant.sms_enabled / sms_daily_max are the runtime limits.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_WEBHOOK_URL=https://<production-alias>/api/webhooks/twilio
SMS_ENABLED=false
SMS_ALLOWLIST=
# Sign in with Apple token revocation on account deletion (plan §23.C). Private key is the .p8 contents.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Email (staff paging, injury notices). Supabase Auth SMTP is configured in the dashboard with the same Resend credentials.
RESEND_API_KEY=
STAFF_EMAIL_FROM=
JOB_SECRET=
OPEN311_API_KEYS=
NWS_USER_AGENT="RootCause/1.0 (rootcause; contact: contact@example.org)"
SENTRY_DSN_SERVER=
EXPO_ACCESS_TOKEN=

# ---- client (inlined at build time; public configuration, never secrets) ----
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Remote style used by scripts/fetch-map-style.ts and the offline pack; the app renders the bundled snapshot (assets/map/style.json).
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_VISION=on
EXPO_PUBLIC_PILOT=new-brunswick-nj
EXPO_PUBLIC_SENTRY_DSN=
